{{/* Label, Name (the input name), Value. Time: a 24h time; Date: a date.
     both open their picker under the field (app.js) and may still be typed
     (18:30, 1830, 18; 15/10, Oct 15): the server reads it, app.js tidies a
     time to HH:MM. Autofocus: focused on load. */}}
{{ define "components/field" -}}
<label class="relative flex flex-col gap-2">
    <span class="text-label text-text-muted uppercase">{{ .Label }}</span>
    <input name="{{ .Name }}" value="{{ .Value }}" class="h-12 w-full border-2 border-border bg-surface px-3 text-body text-text"{{ if .Time }} inputmode="numeric" maxlength="5" autocomplete="off" data-time{{ end }}{{ if .Date }} autocomplete="off" data-date{{ end }}{{ if .Autofocus }} autofocus{{ end }}>
</label>
{{- end }}
