{{/* Name, Color, Meta (empty hides it). Near: the meta in danger (a deadline
     soon). Past: faded (upcoming's past). Handle: the drag handle (pending).
     Href: a task, selected by a tap and opened by the next (app.js);
     Selected: the butter plate behind it, 8px out to the sides. Card: a row
     in an area's card (pending): no swatch, 12px in, no line under the last;
     its plate fills the card's width, the card's border its sides; under
     the band, or last, it lies on that rule, so no line doubles. */}}
{{ define "components/row" -}}
{{ if .Href }}<a href="{{ .Href }}" data-task{{ if .Selected }} data-selected{{ end }}{{ else }}<div{{ end }} class="{{ if .Past }}opacity-50 {{ end }}{{ if .Card }}px-3 last:border-b-0 {{ end }}group relative isolate flex h-15 items-center gap-3 border-b border-divider">
    {{- if .Href }}
    {{- if .Card }}
    <span class="absolute inset-x-0 -top-px -bottom-px -z-10 hidden border-y-2 border-border bg-accent group-last:-bottom-0.5 group-nth-2:-top-0.5 group-data-selected:block"></span>
    {{- else }}
    <span class="absolute top-0 -right-2 -bottom-px -left-2 -z-10 hidden border-2 border-border bg-accent group-data-selected:block"></span>
    {{- end }}
    {{- end }}
    {{- if not .Card }}
    {{- template "components/swatch" (dict "Color" .Color) }}
    {{- end }}
    <div class="flex min-w-0 flex-1 flex-col">
        <span class="truncate text-body text-text">{{ .Name }}</span>
        {{- with .Meta }}
        <span class="{{ if $.Near }}text-danger{{ else }}text-text-muted{{ end }} font-mono text-mono">{{ . }}</span>
        {{- end }}
    </div>
    {{- if .Handle }}
    <span class="font-mono text-mono text-text-muted">::</span>
    {{- end }}
{{ if .Href }}</a>{{ else }}</div>{{ end }}
{{- end }}
