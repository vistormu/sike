{{/* Text, Color. Due: a deadline, always coral. fills the width it is given;
     the text truncates. Href: a task, selected by a tap and opened by the next
     (app.js); Selected: the fill turns butter. */}}
{{ define "components/chip" -}}
{{ if .Href }}<a href="{{ .Href }}" data-task{{ else }}<span{{ end }}{{ if .Selected }} data-selected{{ end }} class="inline-flex max-w-full min-w-0 items-center border-2 border-border bg-(--fill) px-2 py-1 text-label text-text uppercase data-selected:bg-accent" style="--fill: var(--task-{{ if .Due }}coral{{ else }}{{ .Color }}{{ end }})"><span class="truncate">{{ .Text }}</span>{{ if .Href }}</a>{{ else }}</span>{{ end }}
{{- end }}
