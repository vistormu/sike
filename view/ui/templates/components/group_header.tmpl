{{/* Name (the area), Color, Count. 20px tall, as the screens draw it. */}}
{{ define "components/group_header" -}}
<div class="flex h-5 items-center gap-2">
    {{- template "components/swatch" (dict "Color" .Color) }}
    <span class="text-label text-text uppercase">{{ .Name }}</span>
    <span class="font-mono text-mono text-text-muted">{{ .Count }}</span>
</div>
{{- end }}
