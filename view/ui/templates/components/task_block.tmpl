{{/* Name, Time, Color. fills its container: the timeline sets position and
     height. its own height decides the layout: 46px or more, the name over the
     time; less, the name alone, centered ("compact", figma). Href: a task,
     selected by a tap and opened by the next (app.js); Selected: the fill turns
     butter. */}}
{{ define "components/task_block" -}}
<div class="size-full [container-type:size]">
{{ if .Href }}<a href="{{ .Href }}" data-task{{ else }}<div{{ end }} class="flex size-full items-center gap-1 overflow-hidden border-2 border-border bg-(--fill) px-2 text-text data-selected:bg-accent [@container(min-height:46px)]:flex-col [@container(min-height:46px)]:items-start [@container(min-height:46px)]:pt-2"{{ if .Selected }} data-selected{{ end }} style="--fill: var(--task-{{ .Color }})">
    <span class="w-full truncate text-strong">{{ .Name }}</span>
    {{- with .Time }}
    <span class="hidden w-full truncate font-mono text-mono opacity-75 [@container(min-height:46px)]:block">{{ . }}</span>
    {{- end }}
{{ if .Href }}</a>{{ else }}</div>{{ end }}
</div>
{{- end }}
