{{/* Name, Label. On: checked. */}}
{{ define "components/check" -}}
<label class="group inline-flex cursor-pointer items-center gap-2 text-body text-text">
    <input type="checkbox" name="{{ .Name }}" class="sr-only"{{ if .On }} checked{{ end }}>
    <span class="flex size-5 shrink-0 items-center justify-center border-2 border-border bg-surface text-strong group-has-checked:bg-accent"><span class="invisible group-has-checked:visible">✓</span></span>
    {{- .Label -}}
</label>
{{- end }}
