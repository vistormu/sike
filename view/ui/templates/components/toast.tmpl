{{/* Message. Error: the danger tone (else info, ink). Action: the 44px Undo. */}}
{{ define "components/toast" -}}
<div class="{{ if .Error }}bg-danger text-text{{ else }}bg-border text-surface{{ end }} flex items-center justify-between gap-3 border-2 border-border py-2 pr-2 pl-4" role="{{ if .Error }}alert{{ else }}status{{ end }}">
    <span class="min-w-0 text-body">{{ .Message }}</span>
    {{- if .Action }}
    <button type="button" class="flex h-11 shrink-0 cursor-pointer items-center bg-accent px-4 text-strong text-text">Undo</button>
    {{- end }}
</div>
{{- end }}
