{{/* Message. the undo action is a 44px butter block. */}}
{{ define "components/toast" -}}
<div class="flex items-center justify-between gap-3 border-2 border-border bg-border py-2 pr-2 pl-4" role="status">
    <span class="min-w-0 truncate text-body text-surface">{{ .Message }}</span>
    <button type="button" class="flex h-11 shrink-0 cursor-pointer items-center bg-accent px-4 text-strong text-text">Undo</button>
</div>
{{- end }}
