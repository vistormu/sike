{{/* a tab's header: Title (and Sub, muted beside it) over the 2px rule.
     Prev, Next, This: the ‹ › Today buttons (week). New (the "+" label) and
     Href open the task form: a button here on desktop, the FAB above the tab
     bar on the phone, hidden while the undo toast or the task form shows; no
     New, no "+". the
     phone's profile emoji is the shell's. Day: the phone's week, titled with
     the picked day's name (app.js renames it) in the same place as every
     tab's title, and no rule: the day picker comes first. Mood: today's faces, on desktop
     before the buttons (partials/mood). Back: the phone's ‹ before the title
     (settings), back where the person came from (app.js), else to Back. */}}
{{ define "partials/header" -}}
<header class="flex items-center justify-between border-b-2 border-border px-4 pt-6 pb-4 md:pr-6 md:pl-8{{ if .Day }} max-md:border-b-0{{ end }}">
    <div class="flex items-center gap-4">
    {{- with .Back }}
    <span class="md:hidden" data-back>{{ template "components/button" (dict "Glyph" "‹" "Href" .) }}</span>
    {{- end }}
    <div class="flex items-baseline gap-3">
        {{- if .Day }}
        <h1 class="text-display md:hidden" data-day-name>{{ .Day }}</h1>
        <h1 class="hidden text-display md:block">{{ .Title }}</h1>
        {{- else }}
        <h1 class="text-display">{{ .Title }}</h1>
        {{- end }}
        {{- with .Sub }}
        <span class="hidden text-body text-text-muted md:inline">{{ . }}</span>
        {{- end }}
    </div>
    </div>
    <div class="hidden items-center gap-2 md:flex">
        {{- with .Mood }}
        <div class="mr-4">{{ template "partials/mood" . }}</div>
        {{- end }}
        {{- if .Prev }}
        {{ template "components/button" (dict "Glyph" "‹" "Href" .Prev) }}
        {{ template "components/button" (dict "Glyph" "›" "Href" .Next) }}
        {{ template "components/button" (dict "Label" "Today" "Href" .This) }}
        {{- end }}
        {{- with .New }}
        {{ template "components/button" (dict "Label" . "Href" $.Href "Primary" true) }}
        {{- end }}
    </div>
</header>
{{- if .New }}
<span class="fixed right-4 bottom-[calc(86px+env(safe-area-inset-bottom))] z-10 md:hidden [body:has([data-undo],[data-task-form])_&]:hidden">{{ template "components/button" (dict "Glyph" "+" "Href" .Href "Fab" true) }}</span>
{{- end }}
{{- end }}
