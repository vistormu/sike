{{/* the task form over a tab: desktop, a 480px side panel on a scrim (click
     it to close); phone, the whole screen with ‹ and Save in its header. */}}
{{ define "partials/task_form" -}}
<div class="fixed inset-0 flex md:bg-text/25">
    <a href="{{ .Close }}" class="hidden flex-1 md:block" aria-label="Close"></a>
    <form method="post" action="{{ .Action }}" class="group/form flex h-dvh w-full flex-col bg-bg md:w-120 md:border-l-2 md:border-border">
        <div class="flex items-center justify-between border-b-2 border-border px-4 pt-6 pb-4 md:hidden">
            {{ template "components/button" (dict "Glyph" "‹" "Href" .Close) }}
            <h1 class="text-title">Task</h1>
            {{ template "components/button" (dict "Label" "Save" "Primary" true "Submit" true) }}
        </div>
        <div class="flex min-h-0 flex-1 flex-col gap-6 overflow-y-auto px-4 pt-4 pb-6 md:p-6">
            <div class="hidden items-center justify-between md:flex">
                <h1 class="text-display">Task</h1>
                {{ template "components/button" (dict "Glyph" "×" "Href" .Close) }}
            </div>
            {{ template "components/field" (dict "Label" "Name" "Name" "name" "Value" .Name "Autofocus" true) }}
            <fieldset class="flex flex-col">
                <legend class="mb-2 text-label text-text-muted uppercase">Area</legend>
                <div class="grid grid-cols-4 gap-x-3 gap-y-2 md:grid-cols-[repeat(3,99px)]">
                    {{- range .Areas }}
                    {{ template "components/area_option" (dict "Name" "area" "Value" .Color "Label" .Name "Color" .Color "Selected" (eq .Color $.Color)) }}
                    {{- end }}
                </div>
            </fieldset>
            <fieldset class="flex flex-col">
                <legend class="mb-2 text-label text-text-muted uppercase">When</legend>
                <div class="flex border-2 border-border bg-surface">
                    {{- range .Whens }}
                    {{ template "components/segment" (dict "Name" "when" "Value" .Value "Label" .Label "Active" (eq .Value $.When)) }}
                    {{- end }}
                </div>
            </fieldset>
            {{- /* shown while "Every week" is picked; other whens ignore it */}}
            <fieldset class="hidden flex-col group-has-[[name=when][value=weekly]:checked]/form:flex">
                <legend class="mb-2 text-label text-text-muted uppercase">Weekly schedule</legend>
                <div class="flex flex-col items-start gap-2" data-places>
                    {{- range .Places }}
                    {{ template "partials/task_form_place" . }}
                    {{- end }}
                    <template data-place>{{ template "partials/task_form_place" .Blank }}</template>
                    <span data-add-time>{{ template "components/button" (dict "Label" "+ Add time") }}</span>
                </div>
            </fieldset>
            {{- with .Delete }}
            <div class="mt-auto flex justify-center md:hidden">
                {{ template "components/button" (dict "Label" "Delete task" "Danger" true "FormAction" .) }}
            </div>
            {{- end }}
            <div class="mt-auto hidden items-center justify-end md:flex">
                {{- with .Delete }}
                <span class="mr-auto">{{ template "components/button" (dict "Label" "Delete task" "Danger" true "FormAction" .) }}</span>
                {{- end }}
                {{ template "components/button" (dict "Label" "Save" "Primary" true "Submit" true) }}
            </div>
        </div>
    </form>
</div>
{{- end }}

{{/* one time of the weekly schedule: weekdays, start and end, the two
     notices. a box with no days is dropped on save. */}}
{{ define "partials/task_form_place" -}}
<div class="flex w-full flex-col gap-3 border-2 border-border bg-surface p-3">
    <input type="hidden" name="place" value="{{ .I }}">
    <div class="flex border-2 border-border bg-surface">
        {{- range .Days }}
        {{ template "components/segment" (dict "Name" (printf "days-%s" $.I) "Value" (printf "%d" .Value) "Label" .Label "Active" .On "Multi" true) }}
        {{- end }}
    </div>
    <div class="flex gap-3">
        <div class="min-w-0 flex-1">{{ template "components/field" (dict "Label" "Start" "Name" (printf "start-%s" .I) "Value" .Start "Type" "time") }}</div>
        <div class="min-w-0 flex-1">{{ template "components/field" (dict "Label" "End" "Name" (printf "end-%s" .I) "Value" .End "Type" "time") }}</div>
    </div>
    <div class="flex items-center gap-4">
        {{ template "components/check" (dict "Name" (printf "notify_start-%s" .I) "Label" "Notify at start" "On" .NotifyStart) }}
        {{ template "components/check" (dict "Name" (printf "notify_end-%s" .I) "Label" "at end" "On" .NotifyEnd) }}
    </div>
</div>
{{- end }}
