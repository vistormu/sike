{{ define "layout" -}}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>sike</title>
    <link rel="stylesheet" href="/static/css/site.css">
    <script src="/static/js/htmx.min.js" defer></script>
    <script src="/static/js/app.js" defer></script>
</head>
<body>
    {{ if .Shell }}{{ template "partials/shell" . }}{{ else }}{{ template "content" .Page }}{{ end }}
    {{- with .Form }}
    {{ template "partials/task_form" . }}
    {{- end }}
    {{- with .Toast }}
    {{/* on the phone, 16px above the tab bar when there is one */}}
    <div class="fixed inset-x-4 bottom-4 mx-auto max-w-[358px]{{ if and $.Shell (not $.Form) }} max-md:bottom-[86px]{{ end }}">{{ template "components/toast" . }}</div>
    {{- end }}
</body>
</html>
{{ end }}
