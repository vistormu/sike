{{ define "content" }}
<div class="flex min-h-full flex-col">
    {{ template "partials/header" (dict "Title" "Pending" "New" "+ New task" "Href" "/pending/new") }}
    {{- with .Groups }}
    <div class="flex flex-col gap-2 px-4 pb-6 md:w-176 md:px-8 md:pt-2">
        {{- range . }}
        <section>
            {{ template "components/group_header" (dict "Name" .Name "Color" .Color "Count" (len .Tasks)) }}
            {{- range .Tasks }}
            {{ template "components/row" (dict "Name" .Name "Color" .Color "Handle" true) }}
            {{- end }}
        </section>
        {{- end }}
    </div>
    {{- else }}
    <p class="flex flex-1 items-center justify-center text-title text-text-muted">Nothing pending</p>
    {{- end }}
</div>
{{ end }}
