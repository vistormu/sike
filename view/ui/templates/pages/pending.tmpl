{{ define "content" }}
<div class="flex min-h-full flex-col">
    {{ template "partials/header" (dict "Title" "Pending" "New" "+ New task" "Href" "/pending/new") }}
    {{- with .Groups }}
    <div class="flex flex-col gap-4 px-4 pt-6 pb-6 md:w-176 md:px-8">
        {{- range . }}
        <section class="flex flex-col border-2 border-border bg-surface">
            {{ template "components/group_header" (dict "Name" .Name "Color" .Color "Count" (len .Tasks) "Band" true) }}
            {{- range .Tasks }}
            {{ template "components/row" (dict "Name" .Name "Color" .Color "Handle" true "Card" true "Href" (printf "/pending/%d" .ID)) }}
            {{- end }}
        </section>
        {{- end }}
    </div>
    {{- else }}
    <p class="flex flex-1 items-center justify-center text-title text-text-muted">Nothing pending</p>
    {{- end }}
</div>
{{ end }}
